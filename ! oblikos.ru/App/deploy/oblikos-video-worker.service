[Unit]
Description=Oblik OS reference video worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapt to the existing web service's user and release directory before installation.
User=oblikos
Group=oblikos
WorkingDirectory=/opt/oblikos/current
EnvironmentFile=/etc/oblikos/production.env
Environment=NODE_ENV=production
# Use the absolute Node path from the existing web service when installing.
ExecStart=/usr/bin/node --conditions=react-server --import=tsx scripts/video-reference-worker.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
