[Unit]
Description=Oblik OS MVP
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=oblikos
Group=oblikos
WorkingDirectory=/opt/oblikos/current
EnvironmentFile=/etc/oblikos/production.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/oblikos/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oblikos

[Install]
WantedBy=multi-user.target
