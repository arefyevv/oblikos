# Production REQUIRED: DATABASE_URL, AUTH_SECRET, NEXTAUTH_URL, MEDIA_STORAGE_DIR.
# Production: NEXTAUTH_URL=https://app.oblikos.ru; MEDIA_STORAGE_DIR=/var/lib/oblikos/media
# Остальные переменные optional / feature-specific. Реальные секреты не коммитить.
# Локальный Docker PostgreSQL (для production DB пароль тоже обязателен).
POSTGRES_USER=oblikos
POSTGRES_PASSWORD=
POSTGRES_DB=oblikos
POSTGRES_PORT=5432
# Новая установка: oblikos_postgres_data. При обновлении укажите существующий том.
POSTGRES_VOLUME_NAME=oblikos_postgres_data
# Пароль и порт должны совпадать с POSTGRES_PASSWORD и POSTGRES_PORT.
DATABASE_URL=
# Пример формата: postgresql://oblikos:YOUR_PASSWORD@127.0.0.1:5432/oblikos

# Сгенерируйте случайный секрет длиной минимум 32 символа (инструкция в README).
AUTH_SECRET=
# Все страницы и callbacks открывайте на одном origin. В production — HTTPS.
NEXTAUTH_URL=http://localhost:3000
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Современный VK ID с PKCE не использует client secret в выбранном flow.
VK_CLIENT_ID=
# development: письма в artifacts/dev-mail; smtp: реальная отправка; disabled: отключена.
EMAIL_PROVIDER=development
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@oblikos.ru
SMTP_PASSWORD=
SMTP_FROM="Oblik OS <noreply@oblikos.ru>"
# true только за доверенным reverse proxy, заменяющим X-Real-IP.
AUTH_TRUST_PROXY=false
# Только локальная проверка production build через loopback HTTP.
AUTH_LOCAL_HTTP=false

# Серверная генерация текста. Без этих значений остальные разделы работают.
OPENAI_API_KEY=
# Необязательно: URL совместимого API. Без него используется стандартный OpenAI API.
OPENAI_BASE_URL=
# Укажите доступную вашему API-проекту текстовую модель Responses API.
OPENAI_MODEL=
# Optional vision-capable model for character photo analysis; defaults to OPENAI_MODEL.
OPENAI_VISION_MODEL=

# Серверная модель изображений, отдельно от текстовой. Без значения генерация отключена.
OPENAI_IMAGE_MODEL=google/gemini-3.1-flash-image
# Для Nano Banana 2: OPENAI_BASE_URL=https://api.proxyapi.ru/v1.
# Gemini использует нативный Google API; остальные модели — /images/edits.
OPENAI_IMAGE_REFERENCE_SUPPORTED=true
# Поддерживаемые выбранной моделью размеры. Selection переводится в ближайший формат.
OPENAI_IMAGE_SIZES=1024x1024,1024x1536,1536x1024
# В development по умолчанию <project>/data/media. На VPS задайте постоянный абсолютный путь.
# Например /var/lib/oblikos/media; при Docker смонтируйте persistent volume в этот путь.
MEDIA_STORAGE_DIR=

# Видео через ProxyAPI /v1/videos, приватный портрет передаётся первым кадром.
# Проверенная модель; OPENAI_BASE_URL=https://api.proxyapi.ru/v1.
OPENAI_VIDEO_MODEL=kwaivgi/kling-v3.0-pro

# Платные AI функции: изменение требует restart. false сохраняет доступ к данным.
AI_GENERATION_ENABLED=true
IMAGE_GENERATION_ENABLED=true
VIDEO_GENERATION_ENABLED=true
VOICE_GENERATION_ENABLED=true
AI_VOICE_PER_MINUTE=3
AI_VOICE_PER_DAY=20
AI_VOICE_GLOBAL_PER_DAY=100
# Qwen3-TTS: отдельный API-ключ Alibaba Cloud Model Studio, регион Singapore.
# Без ключа выбор Qwen сохраняется, но новая проба недоступна.
DASHSCOPE_API_KEY=
# User И workspace: rolling 60 seconds / rolling 24 hours. Failed attempts count.
AI_TEXT_PER_MINUTE=5
AI_TEXT_PER_DAY=50
AI_IMAGE_PER_MINUTE=2
AI_IMAGE_PER_DAY=10
AI_VIDEO_PER_MINUTE=1
AI_VIDEO_PER_DAY=5
# Общий потолок приложения: защищает баланс от множества новых аккаунтов.
AI_TEXT_GLOBAL_PER_DAY=200
AI_IMAGE_GLOBAL_PER_DAY=40
AI_VIDEO_GLOBAL_PER_DAY=20
# Значения только positive integer; максимум minute=100/day=500/global day=5000.
# На VPS включите EMAIL_PROVIDER=smtp и заполните SMTP-настройки для отправки писем.

# Озвучка через AITUNNEL и говорящее видео HeyGen Avatar IV (только сервер).
# Для видео нужны также настройки выбранного голоса персонажа и средства на балансе.
AITUNNEL_API_KEY=

# Uploaded audio → Avatar IV. Published catalog on 2026-10-09: 8.50 RUB/sec.
# Explicit empty prices block paid reference-video submissions; review current tariffs.
AVATAR_PRICE_RUB_PER_SECOND=
# Kling 3.0 Pro Motion Control, direct fal adapter (independent of ProxyAPI).
FAL_KEY=
MOTION_PRICE_USD_PER_SECOND=
# Default: existing AITUNNEL key, Hailuo 3, 5–15 sec / 2K.
MOTION_VIDEO_PROVIDER=aitunnel
MOTION_VIDEO_MODEL=seedance-2.0-mini
# AITUNNEL Seedance Mini, 720p, RUB/sec, catalog checked 2026-10-12.
SEEDANCE_PRICE_RUB_PER_SECOND=12.852
SEEDANCE_SQUARE_PRICE_RUB_PER_SECOND=7.22925
# Set from the current public model catalog. Verified 2026-10-09: 22.1 RUB/sec.
MOTION_PRICE_RUB_PER_SECOND=
# Set true only when the worker is supervised and running with the same DB/storage/env.
REFERENCE_VIDEO_WORKER_ENABLED=false
# Upload disk quotas (user/workspace/global), independent of paid AI limits.
MEDIA_UPLOAD_PER_MINUTE=5
MEDIA_UPLOAD_PER_DAY=30
MEDIA_UPLOAD_GLOBAL_PER_DAY=200
